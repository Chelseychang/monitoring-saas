# ============================================
# Telegram SaaS Environment Variables Template
# ============================================
#
# SECURITY NOTICE:
# 1. Never commit actual secrets to git
# 2. Copy this file to .env and fill in your values
# 3. Set production secrets in Railway/Vercel dashboard
# 4. Rotate secrets immediately if exposed
#
# ============================================

# ---- Lark Bot Configuration ----
# Get these from Lark Open Platform (open.larksuite.com)
# Bot Settings → Security Settings
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/YOUR_WEBHOOK_ID
LARK_BOT_SECRET=YOUR_SECRET_HERE_FROM_LARK_DASHBOARD

# ---- Application URLs ----
# Public URL where your monitoring platform is deployed
MONITORING_PLATFORM_URL=https://your-public-monitoring-domain.com

# Frontend API endpoint (points to your push server)
VITE_PUSH_API_URL=http://localhost:8787

# Frontend platform URL (for local dev)
VITE_PLATFORM_URL=http://localhost:5173

# ---- Server Configuration ----
# Port for the push API server
PUSH_SERVER_PORT=8787

# Minimum AI score to trigger push (0-100)
PUSH_MIN_SCORE=70

# ---- Cron Job Configuration ----
# Enable/disable Telegram crawler cron job
ENABLE_TELEGRAM_CRON=false

# Telegram cron schedule (cron expression)
TELEGRAM_CRON=*/5 * * * *

# Enable/disable TradingView crawler cron job
ENABLE_TRADINGVIEW_CRON=false

# TradingView cron schedule (cron expression)
TRADINGVIEW_CRON=*/10 * * * *

# ---- CORS Configuration ----
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://intelligencemonitoring.vercel.app,http://localhost:5173

# ---- Data Security (P1 features) ----
# Enable data masking for sensitive info
ENABLE_DATA_MASKING=true

# Enable audit logging
ENABLE_AUDIT_LOG=true

# Database path for SQLite
DB_PATH=./data/intelligence.db

# ---- Advanced Configuration (P2 features) ----
# Node environment
NODE_ENV=development

# Log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Data retention period in days
DATA_RETENTION_DAYS=90

# Circuit breaker timeout (milliseconds)
CIRCUIT_BREAKER_TIMEOUT=30000

# Rate limit per minute
RATE_LIMIT_PER_MINUTE=20
