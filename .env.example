# Lark / Feishu custom bot webhook
# Example Lark:  https://open.larksuite.com/open-apis/bot/v2/hook/xxxxxxxx
# Example Feishu: https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/WEBHOOK_ID_REMOVED

# Optional: only fill this if Signature Verification is enabled in Lark bot security settings.
# LARK_BOT_SECRET=

# Used by the Lark card button: 打开监控平台
# MONITORING_PLATFORM_URL=https://your-public-monitoring-domain.com

# Local push server port
# PUSH_SERVER_PORT=8787

# Frontend calls this local push server.
# VITE_PUSH_API_URL=http://localhost:8787

# Server
PORT=8787
PUSH_SERVER_PORT=8787

# CORS
ALLOWED_ORIGINS=https://intelligencemonitoring.vercel.app,http://localhost:5173

# Lark
LARK_WEBHOOK_URL=
LARK_BOT_SECRET=

# Platform URL shown in Lark button
MONITORING_PLATFORM_URL=https://intelligencemonitoring.vercel.app

# Telegram auto refresh
ENABLE_TELEGRAM_CRON=true
TELEGRAM_CRON=*/5 * * * *
PUSH_MIN_SCORE=70

# Frontend
VITE_PUSH_API_URL=http://localhost:8787
VITE_PLATFORM_URL=http://localhost:5173

# TradingView auto refresh
ENABLE_TRADINGVIEW_CRON=true
TRADINGVIEW_CRON=*/10 * * * *
TRADINGVIEW_NEWS_URL=https://www.tradingview.com/news/
TRADINGVIEW_LIMIT=8